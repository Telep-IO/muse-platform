# Separate Express/Docker/Coolify deploy. Unprefixed names below stay for that process.
# The Vercel project uses PAPER_SEND_* in the repo-root .env.example. See docs/VERCEL-ENV.md.
# demo = no external calls; test = Stripe + Lob test keys; live = real money/mail
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DATA_DIR=./data
# Optional for local demo; make deploy requires Neon/PostgreSQL.
# Copy the Neon pooled connection URL, with sslmode=verify-full.
# Use a separate database for each mode. PDFs are NEVER stored in this database.
DATABASE_URL=
# Set to 1 ONLY behind one trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LOB_API_KEY=
SUPPORT_EMAIL=
BUSINESS_NAME=PaperSend
# Required in live mode; use the real operator identity/contact details.
LEGAL_BUSINESS_NAME=
BUSINESS_ADDRESS=
# Reference the actual Lob written authorization/agreement; not a permission toggle.
# It must cover this customer-facing paid API workflow. Keep the evidence securely.
LOB_AUTHORIZATION_REFERENCE=
# Enable after configuring Stripe Tax and the correct product tax code.
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_CODE=
