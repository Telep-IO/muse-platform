# Separate Express/Docker/Coolify deploy. Unprefixed names below stay for that process.
# The Vercel project uses DOMAIN_SEND_* in the repo-root .env.example. See docs/VERCEL-ENV.md.
# demo = no external calls; test = Stripe test keys (+ provider test keys once integrated); live = real money/registrations
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DATA_DIR=./data
# Optional for local demo; production uses PostgreSQL.
# Copy the pooled connection URL, with sslmode=verify-full.
# Use a separate database for each mode. Registrant contact details ARE stored
# in this database (needed for registration); purge rules are in src/domains.js.
DATABASE_URL=
# Set to 1 ONLY behind one trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# TODO(terms-diligence): reseller API credentials go here once OpenSRS (or the
# chosen reseller platform) onboarding is complete. See TERMS-DILIGENCE.md.
# RESELLER_API_KEY=
# RESELLER_USERNAME=
SUPPORT_EMAIL=
BUSINESS_NAME=DomainSend
# Required in live mode; use the real operator identity/contact details.
LEGAL_BUSINESS_NAME=
BUSINESS_ADDRESS=
# Reference the actual reseller agreement/account approval; not a permission toggle.
# It must cover operating a paid customer-facing domain registration service.
# Keep the evidence securely.
DOMAIN_AUTHORIZATION_REFERENCE=
# Enable after configuring Stripe Tax and the correct product tax code.
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_CODE=
