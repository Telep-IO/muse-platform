# Separate Express/Docker/Coolify deploy. Unprefixed names below stay for that process.
# The Vercel project uses CALL_SEND_* in the repo-root .env.example. See docs/VERCEL-ENV.md.
# --- mode: demo | test | live ---
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DATA_DIR=./data

# --- payments (test/live only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- voice provider (test/live only) ---
# TODO: Twilio Programmable Voice is the planned provider. Do NOT put real
# keys here until Twilio's terms are confirmed in writing to permit a paid,
# customer-facing third-party service (see TERMS-DILIGENCE.md). Live mode
# additionally requires CALL_AUTHORIZATION_REFERENCE (see src/config.js).
CALL_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_SECRET=
CALL_AUTHORIZATION_REFERENCE=

# --- business identity (live only) ---
SUPPORT_EMAIL=
LEGAL_BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_NAME=CallSend

# --- ops ---
TRUST_PROXY=
