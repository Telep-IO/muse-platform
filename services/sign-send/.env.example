# Separate Express/Docker/Coolify deploy. Unprefixed names below stay for that process.
# The Vercel project uses SIGN_SEND_* in the repo-root .env.example. See docs/VERCEL-ENV.md.
# demo = no external calls; test = Stripe test keys (+ provider test keys once integrated); live = real money/signing
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DATA_DIR=./data
# Optional for local demo; production uses PostgreSQL.
# Copy the pooled connection URL, with sslmode=verify-full.
# Use a separate database for each mode. PDFs are NEVER stored in this database.
DATABASE_URL=
# Set to 1 ONLY behind one trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# TODO(terms-diligence): provider API key goes here once a provider with a
# confirmed white-label/partner track is selected. See TERMS-DILIGENCE.md.
# ESIGN_API_KEY=
SUPPORT_EMAIL=
BUSINESS_NAME=SignSend
# Required in live mode; use the real operator identity/contact details.
LEGAL_BUSINESS_NAME=
BUSINESS_ADDRESS=
# Reference the actual provider written authorization/agreement; not a permission toggle.
# It must cover this customer-facing paid API workflow. Keep the evidence securely.
ESIGN_AUTHORIZATION_REFERENCE=
# Enable after configuring Stripe Tax and the correct product tax code.
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_CODE=
