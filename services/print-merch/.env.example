# Separate Express deploy. Unprefixed names stay for this process.
# The Vercel gateway uses PRINT_MERCH_* in the repo-root .env.example.
# demo = no Printify or Stripe HTTP; test = Printify + Stripe test keys; live = production.
# Leave every secret empty. Do not commit real keys.
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
SERVICE_PUBLIC_URL=http://localhost:3000
# Optional Postgres. Use a separate database for each APP_MODE.
# Remote URLs need sslmode=verify-full. Live mode requires DATABASE_URL.
DATABASE_URL=
# Printify personal access token for the Telep IO LLC merchant shop. No test_/live_ prefix.
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
# Shared with the gateway. test mode expects sk_test_; live expects sk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Verifies Printify X-Pfy-Signature. Required in test and live. Leave empty in git.
PRINTIFY_WEBHOOK_SECRET=
# Required in live so draft routes are not anonymous. Placeholder only.
SERVICE_TOKEN=
# Integer basis points. Default 2500 = 25% of (base + shipping). Works with or without Printify Premium.
MARKUP_BPS=2500
