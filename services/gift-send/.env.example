# Separate Express deploy. Unprefixed names below stay for that process.
# The Vercel project uses GIFT_SEND_* in the repo-root .env.example. See docs/VERCEL-ENV.md.
# demo = no Tremendous and no Stripe calls; test = Tremendous sandbox; live = production after Platform Client registration.
# Do not put a self-serve Tremendous API key in live. Platform Client registration with Sales is required first.
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
SERVICE_PUBLIC_URL=http://127.0.0.1:3000
DATA_DIR=./data
# Postgres in production. Use a separate database for each APP_MODE.
# Remote URLs need sslmode=verify-full. Live mode refuses to boot without DATABASE_URL.
DATABASE_URL=
# Empty in git. Paste in the host's secret store, never in chat or the PR.
TREMENDOUS_API_KEY=
# HMAC secret for Tremendous webhooks. Required in test and live. Empty in git.
TREMENDOUS_WEBHOOK_SECRET=
# Non-secret reference recorded after Platform Client registration with Tremendous Sales.
# Required before APP_MODE=live. Leave empty until Sales confirms registration. This is not an API key.
TREMENDOUS_PLATFORM_CLIENT_REFERENCE=
# Customer service fee in cents. Default 299 ($2.99) when unset.
# Face value is a pass-through. Tremendous's fee on gift cards, Visa/Mastercard prepaid, and charity is $0.
SERVICE_FEE_CENTS=299
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Optional bearer required on /drafts and /gifts when set. Webhooks stay signature-checked instead.
SERVICE_TOKEN=
