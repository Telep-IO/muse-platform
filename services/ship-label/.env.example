# Separate Express deploy. Unprefixed names below stay for that process.
# The Vercel project uses SHIP_LABEL_* in the repo-root .env.example. See docs/VERCEL-ENV.md.
# demo = no EasyPost and no Stripe calls; test = EasyPost test key + Stripe test key; live = Forge production key.
# Do not put a self-serve Developer Plan key in live. Forge enrollment is required first.
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
SERVICE_PUBLIC_URL=http://127.0.0.1:3000
DATA_DIR=./data
# Postgres in production. Use a separate database for each APP_MODE.
# Remote URLs need sslmode=verify-full. Live mode refuses to boot without DATABASE_URL.
DATABASE_URL=
# Empty in git. Paste in the host's secret store, never in chat or the PR.
EASYPOST_API_KEY=
# Non-secret reference to the signed Forge Order Form. Required before APP_MODE=live.
# Leave empty until EasyPost sales completes enrollment. This is not an API key.
EASYPOST_ORDER_FORM_REFERENCE=
# Forge per-label platform fee in cents, from the Order Form. Empty until that number exists.
# Do not guess it. The customer total is postage + SERVICE_FEE_CENTS, not this value.
EASYPOST_PLATFORM_FEE_CENTS=
# Customer service fee in cents. Default 199 ($1.99) when unset.
SERVICE_FEE_CENTS=199
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Optional bearer required on /drafts and /labels when set. Stripe webhooks stay signature-checked instead.
SERVICE_TOKEN=
