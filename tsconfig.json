{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@telep/registry": ["./packages/registry/src/index.ts"],
      "@telep/platform": ["./packages/platform/src/index.ts"],
      "@telep/paper-send": ["./connectors/paper-send/src/index.ts"],
      "@telep/print-merch": ["./connectors/print-merch/src/index.ts"],
      "@telep/gift-send": ["./connectors/gift-send/src/index.ts"],
      "@telep/ship-label": ["./connectors/ship-label/src/index.ts"],
      "@telep/sign-send": ["./connectors/sign-send/src/index.ts"],
      "@telep/fax-send": ["./connectors/fax-send/src/index.ts"],
      "@telep/call-send": ["./connectors/call-send/src/index.ts"],
      "@telep/ink-send": ["./connectors/ink-send/src/index.ts"],
      "@telep/domain-send": ["./connectors/domain-send/src/index.ts"],
      "@telep/sumvid": ["./connectors/sumvid/src/index.ts"],
      "@telep/shipsignal": ["./connectors/shipsignal/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "services"]
}
