# Muse platform — env template for local dev and the Vercel project.
# Catalog + gateway are one Next.js app. Paste names into
# Vercel → Settings → Environment Variables, fill values there, then Redeploy.
# See docs/VERCEL-ENV.md.
#
# Secrets stay empty in git. Do not commit Stripe, Lob, Twilio, or provider keys.
# The gateway reads connector-prefixed vars when that connector's *_APP_MODE is
# test or live. Unset or demo keeps the in-memory stub. test/live calls the
# provider from this Next.js process. PaperSend is the paid-send path: a verified
# Stripe webhook asks Lob to send when PAPER_SEND_APP_MODE is test or live.
# Demo never calls Lob. Other connectors still do not fax, dial, send a signature
# request, or register a domain. Sumvid summarize spends credits.
# AfterShip/EasyPost tracking may meter a plan. See docs/VERCEL-ENV.md.
#
# Express apps under services/ are not deployed by Vercel. If one runs on
# Docker/Coolify, use that directory's .env.example with the unprefixed names.
# Do not copy PAPER_SEND_ / SIGN_SEND_ prefixes into the Express process.

# =============================================================================
# Shared — catalog, gateway, Stripe, operator identity
# =============================================================================

# Local: catalog + gateway share one Next.js process.
NEXT_PUBLIC_CATALOG_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Production (Vercel):
# NEXT_PUBLIC_CATALOG_URL=https://muse.telep.io
# NEXT_PUBLIC_API_URL=https://api.muse.telep.io

# Comma-separated API keys. Format: muse_sk_{demo|test|live}_{token}
# The demo key is for local docs try-it forms and smoke tests only.
# On Vercel Production, replace it with real keys. Do not commit those.
MUSE_API_KEYS=muse_sk_demo_localdev

# Gateway Stripe helpers stay in stub mode until these are set.
# PaperSend checkout uses the secret key. The webhook secret verifies
# POST /v1/billing/webhook. Use Stripe test mode until a test smoke is green.
# Paste in the Vercel dashboard only. Leave empty in git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local defaults. Production: https://muse.telep.io/docs
STRIPE_SUCCESS_URL=http://localhost:3000/docs
STRIPE_CANCEL_URL=http://localhost:3000/docs

# Optional. PaperSend, SignSend, and DomainSend Express apps read the unprefixed
# names when Stripe Tax is configured. The gateway does not. Leave disabled.
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_CODE=

# Operator identity. Express apps require these in live mode (unprefixed).
# One Vercel project holds the shared copies for later gateway wiring.
SUPPORT_EMAIL=
LEGAL_BUSINESS_NAME=
BUSINESS_ADDRESS=

# =============================================================================
# PaperSend — paid send runs in this Next.js gateway. No Express deploy required.
# Express names (only if you also run services/paper-send): APP_MODE, LOB_API_KEY,
# LOB_AUTHORIZATION_REFERENCE, DATABASE_URL.
# Lob key prefix must match mode (test_ or live_). Leave the key empty in git.
# demo: in-memory stub, Lob is never called.
# test/live: DATABASE_URL or PAPER_SEND_DATABASE_URL is required or create returns
# "DATABASE_URL required". Lob sends only after the Stripe webhook marks the job paid.
# =============================================================================

PAPER_SEND_APP_MODE=demo
PAPER_SEND_LOB_API_KEY=
PAPER_SEND_LOB_AUTHORIZATION_REFERENCE=
# Neon-style pooled Postgres URL (sslmode=require is fine). Either name works.
# The gateway prefers PAPER_SEND_DATABASE_URL, then DATABASE_URL.
# Empty: demo stays in memory. test/live refuses to store jobs.
PAPER_SEND_DATABASE_URL=
DATABASE_URL=
# Optional. Not used for the in-gateway paid send. Set only for a separate Express deploy.
PAPER_SEND_SERVICE_URL=

# =============================================================================
# Sumvid — demo mode is an in-memory stub. test/live reads the vars below.
# No sumvid service and no sumvid-muse README in this repo (registry links
# Telep-IO/sumvid-muse). test/live calls:
#   POST {SUMVID_API_BASE_URL}/v1/summaries
#   Authorization: Bearer {SUMVID_API_KEY}
#   JSON: { youtubeUrl, videoId, language }
# A 402 or error.code insufficient_credits is returned with topUpUrl when present.
# GET {SUMVID_API_BASE_URL}/v1/account is the credential check (no summarize).
# =============================================================================

SUMVID_APP_MODE=demo
SUMVID_API_BASE_URL=
SUMVID_API_KEY=

# =============================================================================
# ShipSignal — demo mode hashes a timeline. test/live reads the vars below.
# No shipsignal service and no shipsignal-muse README in this repo (registry
# links Telep-IO/shipsignal-muse).
# SHIPSIGNAL_PROVIDER: aftership | shippo | easypost.
# Direct ups/usps/fedex/dhl keys are not called. Per-carrier placeholders below
# stay commented until an aggregator is not used.
# =============================================================================

SHIPSIGNAL_APP_MODE=demo
# aftership | shippo | easypost
SHIPSIGNAL_PROVIDER=
SHIPSIGNAL_API_KEY=
# Optional single-carrier placeholders if not using one aggregator key.
# Commented so they are not required Vercel rows. Uncomment only after a provider is chosen.
# SHIPSIGNAL_UPS_API_KEY=
# SHIPSIGNAL_USPS_API_KEY=
# SHIPSIGNAL_FEDEX_API_KEY=
# SHIPSIGNAL_DHL_API_KEY=

# =============================================================================
# SignSend — services/sign-send/.env.example
# Express names: APP_MODE, ESIGN_API_KEY, ESIGN_AUTHORIZATION_REFERENCE, DATABASE_URL
# ESIGN_API_KEY is still a TODO in the service until a provider is chosen.
# =============================================================================

SIGN_SEND_APP_MODE=demo
# hellosign (Dropbox Sign) or boldsign. Default when empty in test/live: hellosign.
SIGN_SEND_ESIGN_PROVIDER=
SIGN_SEND_ESIGN_API_KEY=
SIGN_SEND_ESIGN_AUTHORIZATION_REFERENCE=
# Optional Postgres for the Express app. Gateway does not open it.
# Express deploy uses DATABASE_URL. PDFs are never stored in that database.
SIGN_SEND_DATABASE_URL=
# Optional. Set only if the gateway should proxy to a separate Express deploy.
SIGN_SEND_SERVICE_URL=

# =============================================================================
# FaxSend — services/fax-send/.env.example
# Express names: APP_MODE, FAX_PROVIDER, FAX_API_KEY, FAX_API_SECRET,
# FAX_WEBHOOK_SECRET, FAX_AUTHORIZATION_REFERENCE
# TODO: provider is Phaxio or Telnyx Fax after TERMS-DILIGENCE.md. Keys stay empty.
# =============================================================================

FAX_SEND_APP_MODE=demo
FAX_SEND_FAX_PROVIDER=
FAX_SEND_FAX_API_KEY=
FAX_SEND_FAX_API_SECRET=
FAX_SEND_FAX_WEBHOOK_SECRET=
FAX_SEND_FAX_AUTHORIZATION_REFERENCE=
# Optional. Set only if the gateway should proxy to a separate Express deploy.
FAX_SEND_SERVICE_URL=

# =============================================================================
# CallSend — services/call-send/.env.example
# Express names: APP_MODE, CALL_PROVIDER, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
# TWILIO_FROM_NUMBER, TWILIO_WEBHOOK_SECRET, CALL_AUTHORIZATION_REFERENCE
# Planned provider is Twilio Programmable Voice. Keys stay empty until terms allow it.
# =============================================================================

CALL_SEND_APP_MODE=demo
CALL_SEND_CALL_PROVIDER=twilio
CALL_SEND_TWILIO_ACCOUNT_SID=
CALL_SEND_TWILIO_AUTH_TOKEN=
CALL_SEND_TWILIO_FROM_NUMBER=
CALL_SEND_TWILIO_WEBHOOK_SECRET=
CALL_SEND_CALL_AUTHORIZATION_REFERENCE=
# Optional. Set only if the gateway should proxy to a separate Express deploy.
CALL_SEND_SERVICE_URL=

# =============================================================================
# InkSend — services/ink-send/.env.example
# Express names: APP_MODE, INK_PROVIDER, INK_API_KEY, INK_API_SECRET,
# INK_WEBHOOK_SECRET, INK_AUTHORIZATION_REFERENCE
# TODO: provider (Handwrytten or other) after TERMS-DILIGENCE.md. Keys stay empty.
# =============================================================================

INK_SEND_APP_MODE=demo
INK_SEND_INK_PROVIDER=
INK_SEND_INK_API_KEY=
INK_SEND_INK_API_SECRET=
INK_SEND_INK_WEBHOOK_SECRET=
INK_SEND_INK_AUTHORIZATION_REFERENCE=
# Optional. Set only if the gateway should proxy to a separate Express deploy.
INK_SEND_SERVICE_URL=

# =============================================================================
# DomainSend — services/domain-send/.env.example
# Express names: APP_MODE, RESELLER_API_KEY, RESELLER_USERNAME,
# DOMAIN_AUTHORIZATION_REFERENCE, DATABASE_URL
# TODO: OpenSRS (or the chosen reseller) after TERMS-DILIGENCE.md. Keys stay empty.
# =============================================================================

DOMAIN_SEND_APP_MODE=demo
DOMAIN_SEND_RESELLER_API_KEY=
DOMAIN_SEND_RESELLER_USERNAME=
DOMAIN_SEND_DOMAIN_AUTHORIZATION_REFERENCE=
# Postgres for the Express app when used. Registrant contacts are stored there.
# The Next.js gateway does not open it. Express deploy uses DATABASE_URL.
DOMAIN_SEND_DATABASE_URL=
# Optional. Set only if the gateway should proxy to a separate Express deploy.
DOMAIN_SEND_SERVICE_URL=
